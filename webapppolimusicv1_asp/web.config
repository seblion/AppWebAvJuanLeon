<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracion IIS para PoliMusic (ASP clasico).
  - Activa errores detallados de ASP en el navegador (para desarrollo).
  - Habilita rutas principales (incluir ../includes desde admin/).
  - Asegura el estado de sesion (usado por el login).
  NOTA: en produccion cambiar scriptErrorSentToBrowser a "false"
  y httpErrors errorMode a "DetailedLocalOnly".
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.asp" />
        <add value="login.asp" />
        <add value="default.asp" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    <asp scriptErrorSentToBrowser="true"
         appAllowDebugging="true"
         appAllowClientDebug="true"
         enableParentPaths="true"
         bufferingOn="true">
      <session allowSessionState="true" timeout="00:20:00" />
    </asp>
  </system.webServer>
</configuration>
